{
  "name": "naigrey-windows",
  "version": "0.2.3",
  "description": "奶灰桌宠 Windows 预览版",
  "author": "freedomxia",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder --win nsis zip --x64 --publish never",
    "smoke": "electron . --smoke-test --demo",
    "build:native": "powershell -NoProfile -File scripts/build-native.ps1"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.freedomxia.naigrey.windows",
    "productName": "奶灰桌宠",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/clips/*.webm"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "naigrey-windows-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": false,
      "artifactName": "naigrey-windows-${version}-${arch}-setup.exe"
    },
    "extraResources": [
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "native/Naigrey.Senses.exe",
        "to": "native/Naigrey.Senses.exe"
      }
    ]
  }
}
